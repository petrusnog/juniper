# Juniper v4 — Configuração
#
# Copie para `config.yaml` e ajuste. Segredos vão em `.env`.
# Precedência: env > config.yaml > defaults. Ver ADR-003.

llm:
  # Ordem do failover: se o primeiro cair, tenta o próximo.
  priority: [deepinfra, groq, ollama]

  deepinfra:
    model: deepseek-ai/DeepSeek-V4-Flash-0731   # precisa suportar tool calling
    timeout: 30

  groq:
    model: openai/gpt-oss-120b
    timeout: 30
    reasoning_effort: low   # só gpt-oss: menos tokens de raciocínio (economiza o limite do Groq)

  ollama:
    url: http://localhost:11434
    model: llama3.1
    timeout: 300            # CPU: o primeiro pedido carrega o modelo

agent:
  max_iterations: 5
  language: pt-BR
  timezone: America/Sao_Paulo
  show_timing: false      # mostra no terminal o tempo de cada etapa da resposta (também vai para o log)

deployment:
  # local  = brain roda embutido no processo do cliente (Sprint 1)
  # server = brain expõe API para clientes remotos (`juniper serve`, ADR-012)
  mode: local

  server:
    host: 127.0.0.1
    port: 8765

  auth:
    # Token Bearer dos clientes; criado (modo 600) no primeiro `juniper serve`.
    token_file: ~/.juniper/token
    # Usuários e credenciais (ADR-027), no servidor.
    legacy_token: true        # o token acima ainda vale; desligue depois de migrar os clientes
    allow_testers: false      # cadastrar `tester` (ele vê o mesmo cérebro; sem isolamento ainda)
    # No cliente: a credencial salva por `juniper login`.
    # credential_file: ~/.juniper/credential

tools:
  security:
    shell_allowlist:
      - git
      - ls
      - cat
      - grep
      - rg
      - fd
      - jq
      - find
      - wc
      - head
      - tail
    shell_require_confirmation: true
    confirmation_timeout: 60
  open_url:
    # Links desses domínios (e subdomínios) abrem no dispositivo sem perguntar. A política de URL
    # (só http/https, sem endereços privados) vale sempre.
    trusted_domains:
      - music.youtube.com

google:
  # Conta de serviço (ADR-008). A chave fica em certs/ (ignorada pelo git).
  credentials_file: ~/.juniper/certs/gcp-key.json
  calendar_id: SEU_ID_DA_AGENDA@group.calendar.google.com   # agenda "Juniper" (escrita)
  read_calendar_ids: []                                      # agendas só lidas, ex.: [seu@gmail.com]
  # Agendas suas em que ela também cria, altera e apaga (ADR-010). Compartilhe com a conta de
  # serviço com permissão "Fazer alterações em eventos" e liste aqui, ex.: [seu@gmail.com]
  # A primeira é a agenda padrão: é nela que a Juniper agenda, a menos que você peça a "Juniper".
  manage_calendar_ids: []
  default_calendar_id:        # vazio = a primeira de manage_calendar_ids (ou a Juniper, se não houver)
  default_duration_minutes: 60
  reminder_minutes: 30

memory:
  # Memória da conversa (ADR-011). As conversas ficam em arquivos, uma por sessão.
  session:
    max_turns: 8          # turnos do usuário mantidos no histórico
    max_tokens: 6000      # orçamento (estimado) do histórico; os turnos mais antigos saem primeiro
    dir: ~/.juniper/sessions
    store: file           # file (arquivos JSON) ou mongo (precisa do banco abaixo no ar)

  # MongoDB (T-053). Suba com `docker compose up -d`. Usuário e senha ficam no .env.
  mongo:
    uri: mongodb://localhost:27017
    database: juniper
    timeout_ms: 3000      # quanto esperar pelo servidor antes de avisar que está fora do ar

  # Embeddings locais (T-054): o texto das memórias vira vetor na sua máquina, em CPU. O modelo
  # (~120 MB) é baixado na primeira vez que for preciso. Trocar `model` exige `juniper memory reindex`.
  embeddings:
    model: intfloat/multilingual-e5-small
    dir: ~/.juniper/models
    max_length: 512
    batch_size: 16
    threads: 0            # CPU do onnxruntime; 0 = automático (todos os núcleos)

  # Busca na memória de longo prazo (T-055/T-057). Calibre o threshold com exemplos reais.
  retrieval:
    top_k: 5              # no máximo quantas memórias entram no prompt de cada mensagem
    threshold: 0.80       # similaridade mínima (cosseno, -1 a 1); o e5 dá notas altas a tudo
    max_tokens: 500       # orçamento (estimado) das memórias injetadas

  # Extração de memórias da conversa (T-056). Roda ao encerrar o chat, só com `store: mongo`.
  extraction:
    enabled: true
    mode: turn            # turn = em segundo plano a cada resposta; exit = só ao encerrar o chat
    max_per_run: 5        # memórias novas, no máximo, por conversa
    max_chars: 300        # tamanho máximo de cada memória
    max_turns: 20         # turnos recentes enviados ao LLM de extração
    neighbors: 3          # memórias parecidas comparadas antes de gravar
    neighbor_threshold: 0.75
    save_feelings: true   # guarda sentimentos e acontecimentos pessoais (sensível); false = não guarda

  # Perfil (T-061): um parágrafo de identidade (nome, nascimento, nacionalidade) que vai em TODA
  # mensagem, sem busca. Os tokens dele são pagos a cada pergunta: por isso o teto.
  profile:
    enabled: true
    max_chars: 500

trace:
  # Diário das mensagens: cada interação contada em texto corrido, camada por camada
  # (logs/message.log). Guarda o texto das conversas, por isso vem desligado.
  enabled: false

metadocs:
  # A Juniper consultando a própria documentação (ADR-025): busca local por palavras-chave
  # (BM25), sem LLM e sem rede. Só lê docs/pages e docs/decisions, nunca segredos.
  enabled: true
  auto_context: true     # pergunta sobre ela mesma já leva os trechos no turno (sem volta extra)
  top_k: 3               # seções por consulta
  max_chars: 1500        # teto dos trechos entregues ao modelo
