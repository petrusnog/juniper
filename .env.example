# Juniper v4 — Variáveis sensíveis
#
# Copie para `.env` e preencha. `.env` NUNCA é versionado.
# Todas as variáveis usam o prefixo JUNIPER_.

# DeepInfra (provider principal) — https://deepinfra.com/dash/api_keys
JUNIPER_DEEPINFRA_API_KEY=

# Groq (segunda opção) — https://console.groq.com/keys
JUNIPER_GROQ_API_KEY=

# MongoDB da memória (só se memory.session.store: mongo). Os docker-compose*.yml usam estes
# mesmos valores para criar o usuário do banco: defina antes de `docker compose up -d`.
JUNIPER_MEMORY__MONGO__USERNAME=
JUNIPER_MEMORY__MONGO__PASSWORD=

# Overrides opcionais (se ausentes, config.yaml manda)
# JUNIPER_LLM__OLLAMA__URL=http://localhost:11434
# JUNIPER_AGENT__LANGUAGE=pt-BR
# JUNIPER_LOG_LEVEL=INFO
# JUNIPER_CONFIG_PATH=/caminho/customizado/config.yaml

# Produção em contêiner (docker-compose.prod.yml, ADR-013). Todas opcionais.
# TAILSCALE_IP=100.x.y.z                 # onde publicar a porta 8765 (padrão: 127.0.0.1)
# JUNIPER_IMAGE=ghcr.io/petrusnog/juniper:<sha>   # imagem do brain (padrão: construída localmente)
# JUNIPER_CONFIG_FILE=./config.yaml      # config do brain (padrão: docker/config.prod.yaml)
# JUNIPER_BASE_CONFIG_FILE=./config.yaml   # seu config pessoal (agendas do Google...) como camada base
