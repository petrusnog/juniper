{
  "name": "juniper-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Juniper desktop client (Electron, Windows) - ADR-033",
  "main": "dist/main/index.js",
  "scripts": {
    "gen:protocol": "node scripts/gen-protocol-types.js",
    "check:protocol": "node scripts/gen-protocol-types.js --check",
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "punycode": "^2.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/punycode": "^2.1.4",
    "@types/ws": "^8.5.12",
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
